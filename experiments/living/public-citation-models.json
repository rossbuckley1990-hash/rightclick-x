          "path": "message.publisher"
        },
        {
          "op": "exists",
          "path": "message.title"
        }
      ],
      "publish": "Structure primary publication metadata"
    }
  ],
  "adaptation": true,
  "modelReuse": [
    {
      "id": "sol61-positive",
      "model": "gpt-6.1-sol",
      "entryId": "2LYZ",
