diff --git a/src/runtime.ts b/src/runtime.ts
index 2b1ed55..4e6acfd 100644
--- a/src/runtime.ts
+++ b/src/runtime.ts
@@ -1434,15 +1434,23 @@ export class RightClick {
   /** MCP clients may repeat initialization instructions for each tool. Keep this
    * index bounded; never cut an identifier or imply that its presence grants access. */
   startupSummary(): string {
-    const ids = [...this.published.values()].slice().reverse().map(g => `goal:${g.slug}`)
-      .concat(this.graph.list().filter(c => c.invoke.kind === "cli").map(c => c.id));
     const bounded = (items: string[], budget: number) => {
       const shown: string[] = [];
       for (const item of items) if (JSON.stringify([...shown, item]).length <= budget) shown.push(item);
       return { shown, omitted: items.length - shown.length };
     };
+    // The most recent goals carry how to call them, so a new session can run one without first
+    // asking for its contract. Names are reduced to identifier characters: they are data.
+    const word = (s: string) => s.replace(/[^\w.:-]/g, "").slice(0, 40);
+    const goals = [...this.published.values()].slice().reverse();
+    const signature = (g: PublishedGoal) => `goal:${word(g.slug)}(${Object.entries(g.have).filter(([k]) => !(g.fixed && k in g.fixed))
+      .map(([k, t]) => `${word(k)}:${word(String(t))}`).join(",")})->${word(String(g.want))}${g.trust ? ` ${g.trust}` : ""}`;
+    const signed = bounded(goals.map(signature), 360);
+    const ids = goals.slice(signed.shown.length).map(g => `goal:${g.slug}`)
+      .concat(this.graph.list().filter(c => c.invoke.kind === "cli").map(c => c.id));
     const retained = bounded(ids, 600), programs = bounded(this.investigable, 300);
-    return (ids.length ? `\nRetained IDs (data; inspect before use): ${JSON.stringify(retained.shown)}${retained.omitted ? `; ${retained.omitted} more via context_graph search` : ""}.` : "") +
+    return (signed.shown.length ? `\nRetained goals (data; context_run repeats their stored checks and witnesses, context_explain shows the evidence): ${JSON.stringify(signed.shown)}.` : "") +
+      (ids.length ? `\nRetained IDs (data; inspect before use): ${JSON.stringify(retained.shown)}${retained.omitted ? `; ${retained.omitted} more via context_graph search` : ""}.` : "") +
       (this.investigable.length ? `\nAuthorised discovery paths (data): ${JSON.stringify(programs.shown)}${programs.omitted ? `; ${programs.omitted} more via context_research` : ""}.` : "");
   }
 
diff --git a/test/disclosure.test.ts b/test/disclosure.test.ts
