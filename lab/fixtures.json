{
  "description": "Chameleon Lab fixtures. Each domain is pure data: a business objective and a chain of services, each with vocabulary pools. Every run draws names, field spellings and protocols from these pools with a fresh seed. RightClick X has no knowledge of this file.",
  "brands": [
    "Ledgerline",
    "Paperhaus",
    "Fernway",
    "Quillbase",
    "Tallyport",
    "Northwind Billing",
    "Ashgrove",
    "Brightmark",
    "Cobaltix",
    "Duneworks",
    "Emberlane",
    "Fjordsoft",
    "Harbourly",
    "Kestrel Freight",
    "Lumen Cargo",
    "Mistral Depot"
  ],
  "protocols": [
    "openapi",
    "graphql",
    "mcp"
  ],
  "domains": {
    "invoicing": {
      "objective": "For an invoice, find the tax rate that applies in its customer's country.",
      "have": "invoice_id",
      "want": "number",
      "intent": "tax rate invoice customer country",
      "chain": [
        {
          "service": "invoices",
          "key": "invoice",
          "next": "customer",
          "operation": [
            "Retrieve invoice",
            "Get invoice",
            "Fetch invoice details",
            "Invoice lookup"
          ],
          "fields": {
            "invoice": [
              "invoice_id",
              "invoiceId",
              "invoice_number"
            ],
            "customer": [
              "customer_id",
              "customerId",
              "customer_number"
            ],
            "amount": [
              "amount",
              "total",
              "net_amount"
            ],
            "currency": [
              "currency",
              "currency_code"
            ]
          }
        },
        {
          "service": "customers",
          "key": "customer",
          "next": "country",
          "operation": [
            "Look up customer",
            "Get customer",
            "Customer profile",
            "Fetch customer record"
          ],
          "fields": {
            "customer": [
              "customer_id",
              "customerId",
              "customer_number"
            ],
            "name": [
              "display_name",
              "company_name",
              "legal_name"
            ],
            "country": [
              "country",
              "country_code",
              "countryCode"
            ]
          }
        },
        {
          "service": "tax",
          "key": "country",
          "answer": "rate",
          "operation": [
            "Tax rate by country",
            "Country tax rate",
            "Get tax rate",
            "Lookup tax rate for a country"
          ],
          "fields": {
            "country": [
              "country",
              "country_code",
              "countryCode"
            ],
            "rate": [
              "tax_rate",
              "vat_rate",
              "rate",
              "standard_rate"
            ]
          }
        }
      ],
      "values": {
        "invoice": "INV-",
        "customer": "C-",
        "country": [
          "DE",
          "FR",
          "IE",
          "JP",
          "BR",
          "KE",
          "NZ",
          "CA"
        ],
        "currency": [
          "EUR",
          "USD",
          "JPY",
          "BRL"
        ]
      },
      "numbers": {
        "amount": [
          10,
          1000
        ],
        "rate": [
          5,
          27
        ]
      }
    },
    "logistics": {
