CommitDate: Sun Oct 18 12:52:44 2026 +0100

    Preserve main destructive MCP annotation precedence
    
    Conflicting read-only and destructive annotations must not weaken main execution gating. Retain the verified conservative default for unannotated tools. The two new full-path guards fail before this reconciliation and assert discovery plus refusal without a tools/call.

diff --git a/src/reflectors/mcp.ts b/src/reflectors/mcp.ts
index d84bc76..8d87558 100644
--- a/src/reflectors/mcp.ts
+++ b/src/reflectors/mcp.ts
@@ -180,7 +180,8 @@ export function reflectMcpTools(tools: any[], endpoint: string, serverName?: str
     const a = t.annotations ?? {};
     // MCP's defaults: a tool not marked read-only may be destructive unless it says otherwise.
     // Unknown side effects are treated as the most dangerous kind, not the most convenient.
-    const risk: Risk = a.readOnlyHint === true ? "read" : a.destructiveHint === false ? (a.openWorldHint === false ? "write" : "external") : "destructive";
+    // Preserve main's destructive-hint precedence, including malformed truthy annotations.
+    const risk: Risk = a.destructiveHint ? "destructive" : a.readOnlyHint === true ? "read" : a.destructiveHint === false ? (a.openWorldHint === false ? "write" : "external") : "destructive";
     return {
       id: `${providerId}:${slug(t.name)}`,
       title: t.title ?? a.title ?? t.name,
diff --git a/test/discovery-security.test.ts b/test/discovery-security.test.ts
index 953704e..ab226bc 100644
--- a/test/discovery-security.test.ts
+++ b/test/discovery-security.test.ts
@@ -99,3 +99,27 @@ test("A4 redirect: same-origin redirects keep the caller's headers; pinned crede
   assert.equal(seen[2].key, null, "cross-origin hop drops it");
   assert.equal(seen[2].pinned, "Bearer pinned-b", "the operator's credential for b.test still applies at b.test");
 });
+
+for (const destructiveHint of [true, "true"]) {
+  test(`MCP contradictory annotations cannot weaken main's destructive gate (${typeof destructiveHint})`, async () => {
+    let calls = 0;
+    const rc = await RightClick.create({ directories: [], fetch: async (_input, init = {}) => {
+      if (!init.method) return new Response(null, { status: 405 });
+      const body = JSON.parse(String(init.body));
+      if (body.query) return new Response(null, { status: 405 });
+      if (body.method === "notifications/initialized") return new Response(null, { status: 202 });
+      if (body.method === "tools/call") calls++;
+      const result = body.method === "initialize" ? { serverInfo: { name: "risk-fixture" } }
+        : body.method === "tools/list" ? { tools: [{ name: "conflicting_tool", inputSchema: { type: "object" }, annotations: { readOnlyHint: true, destructiveHint } }] }
+        : { content: [{ type: "text", text: "must not execute" }] };
+      return Response.json({ jsonrpc: "2.0", id: body.id, result });
+    } });
+    await rc.learn({ source: "https://risk.test/mcp" });
+    const cap = rc.graph.list().find(c => c.source === "mcp");
+    assert.ok(cap, "the tool must be discovered before its execution gate is tested");
+    assert.equal(cap.risk, "destructive");
+    const result = await rc.run(cap.id, {}).catch(e => ({ status: "failed", error: String(e) }));
+    assert.equal(result.status, "failed");
+    assert.equal(calls, 0, "contradictory or malformed annotations must not authorize execution");
+  });
+}
