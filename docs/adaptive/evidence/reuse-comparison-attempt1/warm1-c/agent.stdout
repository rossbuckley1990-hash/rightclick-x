{"type":"item.completed","item":{"id":"item_3","type":"mcp_tool_call","server":"coding","tool":"read_file","arguments":{"name":"primary-publication.js"},"result":{"content":[{"type":"text","text":"\"const entryId = String(input?.entry_id || '1CRN').toUpperCase();\\nif (!/^[A-Z0-9]{4}$/.test(entryId)) throw new Error('Invalid PDB entry identifier');\\nasync function json(url) { const r = await fetch(url); if (!r.ok) throw new Error(`HTTP ${r.status}`); return r.json(); }\\nconst query = `query { entry(entry_id: ${JSON.stringify(entryId)}) { rcsb_id rcsb_primary_citation { id title pdbx_database_id_DOI year journal_volume page_first page_last } } }`;\\nconst pdb = await json('https://data.rcsb.org/graphql?query=' + encodeURIComponent(query));\\nif (pdb.errors) throw new Error(JSON.stringify(pdb.errors));\\nconst entry = pdb.data?.entry, citation = entry?.rcsb_primary_citation;\\nif (entry?.rcsb_id !== entryId || citation?.id !== 'primary' || !citation.pdbx_database_id_DOI) throw new Error('Primary citation DOI unavailable');\\nconst doi = citation.pdbx_database_id_DOI;\\nconst cr = await json('https://api.crossref.org/works/' + encodeURIComponent(doi));\\nconst m = cr.message;\\nconst normalize = s => s.toLowerCase().replace(/[^a-z0-9]/g, '');\\nif (cr.status !== 'ok' || m.DOI?.toLowerCase() !== doi.toLowerCase() || m.type !== 'journal-article' || !Array.isArray(m.title) || !m.title.length || !m.publisher) throw new Error('Unverified journal article metadata');\\nif (!m.title.some(t => normalize(t) === normalize(citation.title))) throw new Error('Primary citation title mismatch');\\nif (String(m.volume) !== String(citation.journal_volume) || m.page !== `${citation.page_first}-${citation.page_last}` || m.published?.['date-parts']?.[0]?.[0] !== citation.year) throw new Error('Bibliographic cross-check failed');\\nreturn {entry_id:entryId, doi:m.DOI, title:m.title, publisher:m.publisher};\""}],"structured_content":null},"error":null,"status":"completed"}}
