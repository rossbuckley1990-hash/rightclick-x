{"type":"item.started","item":{"id":"item_6","type":"mcp_tool_call","server":"coding","tool":"write_file","arguments":{"name":"primary-publication.js","content":"// Input: {entry_id: string}. Credential-free public reads on authorised RCSB/Crossref origins only.\nconst id = String(input.entry_id || '').trim().toUpperCase();\nif (!id) throw Error('entry_id required');\nasync function json(url) { const r = await fetch(url); if (!r.ok) throw Error(`HTTP ${r.status}`); return r.json(); }\nconst query = 'query($id:String!){entry(entry_id:$id){rcsb_id rcsb_primary_citation{id title pdbx_database_id_DOI journal_abbrev year}}}';\nconst r = await json('https://data.rcsb.org/graphql?' + new URLSearchParams({query, variables:JSON.stringify({id})}));\nif (r.errors) throw Error(JSON.stringify(r.errors));\nconst entry = r.data?.entry;\nconst c = entry?.rcsb_primary_citation;\nif (!entry || c?.id !== 'primary' || !c.pdbx_database_id_DOI) throw Error('Primary citation DOI unavailable');\n// Discover the public bibliographic interface before using it.\nconst spec = await json('https://api.crossref.org/swagger-docs');\nif (!spec.paths?.['/works/{doi}']) throw Error('Crossref works interface unavailable');\nconst record = await json('https://api.crossref.org/works/' + encodeURIComponent(c.pdbx_database_id_DOI));\nconst m = record.message;\nconst norm = s => String(s).toLowerCase().replace(/[^a-z0-9]/g, '');\nif (record.status !== 'ok' || m?.DOI?.toLowerCase() !== c.pdbx_database_id_DOI.toLowerCase()) throw Error('DOI verification failed');\nif (m.type !== 'journal-article') throw Error('Primary citation is not verified as a journal research publication');\nif (!Array.isArray(m.title) || !m.title.length || !m.title.some(t => norm(t) === norm(c.title))) throw Error('Primary citation title mismatch');\nif (!m.publisher || !m['container-title']?.length) throw Error('Publication metadata incomplete');\nreturn {entry_id:entry.rcsb_id, doi:m.DOI, title:m.title, publisher:m.publisher};\n"},"result":null,"error":null,"status":"in_progress"}}
