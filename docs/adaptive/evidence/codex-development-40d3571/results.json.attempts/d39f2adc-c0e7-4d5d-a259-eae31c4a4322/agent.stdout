{"type":"item.completed","item":{"id":"item_3","type":"mcp_tool_call","server":"surface","tool":"read_skill","arguments":{"name":"json-xs-compact"},"result":{"content":[{"type":"text","text":"# Compact JSON with json_xs\n\nUse to squash formatted JSON from stdin into one compact line. Run run_program with args [\"-t\", \"json\"] and the exact JSON text as stdin. Verified output has no trailing newline. Check exit is 0, stderr is empty, and parsing stdout preserves the input structure and values. Check there is no whitespace outside JSON strings (whitespace inside strings must be preserved). Return the program stdout verbatim when an exact result is requested."}],"structured_content":null},"error":null,"status":"completed"}}
