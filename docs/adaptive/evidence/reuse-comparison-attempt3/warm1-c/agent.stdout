{"type":"item.completed","item":{"id":"item_3","type":"mcp_tool_call","server":"coding","tool":"read_file","arguments":{"name":"primary-publication.js"},"result":{"content":[{"type":"text","text":"\"// Input: { entry_id: string }. Read-only RCSB GraphQL and Crossref public APIs.\\n// RCSB's explicitly designated primary citation establishes association; Crossref\\n// confirms the DOI is a journal article and supplies exact title array/publisher.\\nconst entry_id = String(input?.entry_id || '').trim().toUpperCase();\\nif (!/^[A-Z0-9]+$/.test(entry_id)) throw new Error('A valid entry_id is required');\\nasync function get(url) {\\n  const r = await fetch(url);\\n  if (!r.ok) throw new Error(`HTTP ${r.status}`);\\n  return r.json();\\n}\\nconst query = 'query($id:String!){entry(entry_id:$id){rcsb_id rcsb_primary_citation{id title pdbx_database_id_DOI year}}}';\\nconst u = new URL('https://data.rcsb.org/graphql');\\nu.searchParams.set('query', query);\\nu.searchParams.set('variables', JSON.stringify({id:entry_id}));\\nconst graph = await get(u.toString());\\nif (graph.errors) throw new Error(JSON.stringify(graph.errors));\\nconst entry = graph.data?.entry;\\nconst citation = entry?.rcsb_primary_citation;\\nconst doi = citation?.pdbx_database_id_DOI;\\nif (entry?.rcsb_id !== entry_id || citation?.id !== 'primary' || !doi) throw new Error('Primary citation DOI could not be established');\\nconst work = (await get('https://api.crossref.org/works/' + encodeURIComponent(doi))).message;\\nconst normalize = s => String(s).normalize('NFKC').toLowerCase().replace(/[^\\\\p{L}\\\\p{N}]/gu,'');\\nif (work?.DOI?.toLowerCase() !== doi.toLowerCase() || work.type !== 'journal-article') throw new Error('DOI is not a verified journal article');\\nif (!Array.isArray(work.title) || !work.title.length || !work.title.some(t=>normalize(t)===normalize(citation.title))) throw new Error('Publication titles disagree');\\nif (!work.publisher) throw new Error('Publisher unavailable');\\nreturn {entry_id,doi:work.DOI,title:work.title,publisher:work.publisher};\\n\""}],"structured_content":null},"error":null,"status":"completed"}}
