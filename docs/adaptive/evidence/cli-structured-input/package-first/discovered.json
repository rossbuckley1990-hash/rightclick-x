  "selected": {
    "id": "cli:json-xs:stdout",
    "title": "json_xs: exact standard output text",
    "description": "Same authorised invocation as cli:json-xs:invoke, preserving standard output exactly as text. Use for exact formatting, large numbers or duplicate object keys. No JSON value conversion or inferred field projection.",
    "provider": "cli:json-xs",
    "source": "cli",
    "inputs": [
      {
        "name": "json",
        "type": "json",
        "required": false,
        "description": "Content given on standard input. Supply text to preserve its bytes; objects and arrays are serialized as JSON."
      },
      {
        "name": "options",
        "type": "list:text",
        "required": false,
        "description": "Documented options and their values, one item each: -v, -f <fromformat>, -t <toformat>, -e <code>"
      },
      {
        "name": "files",
        "type": "json",
        "required": false,
        "description": "Named input files {\"name.txt\": \"content\"}: staged with exact flat names (no paths or leading dash). Options can refer to these names. All are operands unless \"operands\" selects otherwise."
      },
      {
        "name": "operands",
        "type": "list:text",
        "required": false,
        "description": "Names from \"files\" to append as positional operands, in this order. Omit for all files; [] for none. Auxiliary files used by options need not also be operands."
      }
    ],
    "outputs": [
      {
        "name": "",
        "type": "text",
        "required": true
      }
    ],
    "risk": "read",
    "tags": [
      "json_xs",
      "declared-interface",
      "direct-only",
      "json",
      "json",
      "commandline",
      "utility",
      "exact-stdout",
      "json-text"
    ],
    "invoke": {
