{
  "name": "rightclick-x",
  "version": "0.1.0",
  "description": "A self-composing live capability graph for AI. Reflects any API, GraphQL endpoint, MCP server, web form or peer into one typed graph that plans, runs, verifies and crystallizes multi-provider pipelines.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "rcx": "./dist/rcx.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./edge": "./src/entry/edge.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "demo": "node bin/rcx.ts demo",
    "serve": "node bin/rcx.ts serve --demo",
    "build": "bun build bin/rcx.ts --target node --outfile dist/rcx.mjs && bun build src/entry/edge.ts --target browser --outfile dist/edge.js",
    "build:bin": "bun build bin/rcx.ts --compile --outfile dist/rcx",
    "prepublishOnly": "npm run build && npm test",
    "lab": "node lab/run.ts",
    "lab:report": "node lab/report.ts 10",
    "proof": "node proof/run.ts",
    "proof:ai": "node proof/ai-clients.ts --run",
    "proof:real": "node proof/real-ai.ts --run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.151.0"
  },
  "files": [
    "dist/rcx.mjs",
    "dist/edge.js",
    "src",
    "bin",
    "demo",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "agents",
    "capabilities",
    "openapi",
    "graphql",
    "federation"
  ]
}
